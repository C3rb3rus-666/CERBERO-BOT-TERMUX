# ============================================================================
# .env.arm64 — Variables de entorno optimizadas para ARM64/Termux
# ============================================================================
# Copiar o renombrar a .env para usar automáticamente
# ============================================================================

# ─── Anti-NSFW Optimization (ARM64 Enhanced) ───
# NSFW_FORCE_XENOVA=1 activa Xenova en ARM64 (ONNX WASM, muy eficiente)
NSFW_FORCE_XENOVA=1
# NSFW_DISABLE_XENOVA sin establecer = false (permite usar Xenova)
NSFW_MAX_CONCURRENCY=2
NSFW_MAX_QUEUE=6
NSFW_DETECTION_TIMEOUT_MS=60000

# ─── Presentaciones/Tinder en ARM Safe Mode ───
PRESENTACIONES_ARM_SAFE_MODE=1
PRESENTACIONES_FORCE_NATIVE=0
PRESENTACIONES_CLIP=0
PRESENTACIONES_MAX_IMAGE_BYTES=6291456
PRESENTACIONES_MAX_PENDING=2
PRESENTACIONES_NSFW_TIMEOUT_MS=60000
PRESENTACIONES_CLIP_TIMEOUT_MS=45000
PRESENTACIONES_GROUP_SEND_DELAY_MS=1200

# ─── Modelos ONNX (ARM64: 2-4 threads, WASM optimizado) ───
ONNX_NUM_THREADS=2
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
# Xenova WASM backend preferido en ARM (más estable que CPU native)
XENOVA_BACKEND=wasm

# ─── Memoria Node.js (aumentado a 768MB en ARM64 moderno) ───
NODE_OPTIONS=--max-old-space-size=768 --max-semi-space-size=128

# ─── Python (si se usa nsfw_daemon.py) ───
PYTHONUNBUFFERED=1
# Limitar workers de Python a CPU disponibles (evitar oversubscription)
PYTHON_WORKERS_AUTO=1
