# ============================================================================
# .env.arm64 — Variables de entorno optimizadas para ARM64/Termux
# ============================================================================
# Copiar o renombrar a .env para usar automáticamente
# ============================================================================

# ─── Anti-NSFW Optimization ───
NSFW_MAX_CONCURRENCY=1
NSFW_MAX_QUEUE=4
NSFW_DETECTION_TIMEOUT_MS=45000

# ─── Presentaciones/Tinder en ARM Safe Mode ───
PRESENTACIONES_ARM_SAFE_MODE=1
PRESENTACIONES_FORCE_NATIVE=0
PRESENTACIONES_CLIP=0
PRESENTACIONES_MAX_IMAGE_BYTES=6291456
PRESENTACIONES_MAX_PENDING=2
PRESENTACIONES_NSFW_TIMEOUT_MS=60000
PRESENTACIONES_CLIP_TIMEOUT_MS=45000
PRESENTACIONES_GROUP_SEND_DELAY_MS=1200

# ─── Modelos ONNX (1 thread en ARM para evitar context switching) ───
ONNX_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1

# ─── Memoria Node.js (limitado a 512MB en ARM) ───
NODE_OPTIONS=--max-old-space-size=512 --max-semi-space-size=64

# ─── Python (si se usa nsfw_daemon.py) ───
PYTHONUNBUFFERED=1
